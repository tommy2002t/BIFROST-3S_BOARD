          (noconnect (pad r420_200))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r420_200))
          (noconnect (pad r420_200))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r420_200))
          (noconnect (pad r420_200))
        )
      )
    ); End of padstacks
